{
  "name": "gql-cf-sse-api",
  "version": "1.0.0",
  "private": true,
  "description": "GraphQL API server source code.",
  "scripts": {
    "dev": "pnpm run cf:typegen && wrangler dev",
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "test": "vitest",
    "cf:create-kv": "wrangler kv namespace create GQL_API_KV_STORE",
    "cf:delete-kv": "wrangler kv namespace delete --binding GQL_API_KV_STORE",
    "cf:create-d1": "wrangler d1 create SUBSCRIPTIONS",
    "cf:create-d1:migrations": "wrangler d1 migrations apply SUBSCRIPTIONS",
    "codegen": "pnpm run cf:typegen && pnpm run kysely-codegen && pnpm run gql-codegen",
    "cf:typegen": "wrangler types",
    "kysely-codegen": "kysely-codegen --dialect postgres --env-file .dev.vars --out-file ./src/__generated__/db/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@graphql-authz/core": "^1.3.2",
    "@graphql-authz/directive": "^1.1.6",
    "@graphql-authz/envelop-plugin": "^1.0.7",
    "@graphql-yoga/plugin-disable-introspection": "^2.19.0",
    "@graphql-yoga/plugin-graphql-sse": "^3.18.0",
    "@types/pg": "^8.16.0",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "graphql-sse": "^2.6.0",
    "graphql-yoga": "^5.18.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.11.1",
    "@types/node": "^24.10.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.54.0"
  },
  "packageManager": "pnpm@10.2.1"
}
